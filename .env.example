# NOTE: FRAPPE_URL and SOCKETIO_URL are BUILD-TIME settings, not runtime ones. They are
# interpolated into the proxy rewrites in next.config.mjs, which `next build` freezes into
# the routes manifest — the production server reads that manifest and never re-evaluates
# the config. So this file configures `npm run dev` and `npm run build`; changing either
# value for an already-built app (or on a running container) has no effect. In deployment
# they are passed as Docker build args instead — see CICD.md.

# Base URL of the Frappe backend the Next server proxies to.
# Server-side only — never exposed to the browser.
FRAPPE_URL=http://127.0.0.1:8000

# Base URL of Frappe's Socket.IO server (realtime). Server-side only; the Next
# server proxies /socket.io same-origin to it. Defaults to Frappe's dev socketio
# port. In production this is the backend host — Frappe's own nginx serves
# /socket.io on the same origin as the API.
SOCKETIO_URL=http://127.0.0.1:9000
