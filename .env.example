# Base URL of the Frappe backend the Next server proxies to.
# Server-side only — never exposed to the browser. REQUIRED in production
# (the app refuses to start without it); defaults to localhost in dev.
FRAPPE_URL=http://127.0.0.1:8000

# Base URL of Frappe's Socket.IO server (realtime). Server-side only; the Next
# server proxies /socket.io same-origin to it. Defaults to Frappe's dev socketio
# port. In production point this at the host nginx serves /socket.io from.
SOCKETIO_URL=http://127.0.0.1:9000

# Show the admin "Simulate inbound email" demo tool. Off by default in
# production; any value other than "1" hides it. (Dev shows it automatically.)
# NEXT_PUBLIC_ENABLE_SIMULATE=1
