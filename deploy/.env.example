# Portainer stack environment for the Inventive Helpdesk frontend.
# Set these in Portainer (Stacks -> inventive-helpdesk-frontend -> Environment variables).
# This file is a template — never commit real values.

# ---- Image ----
IMAGE_NAME=ghcr.io/inventive-business-solutions/prod-inventive-helpdesk-frontend

# Keep this as "latest". `docker stack deploy` re-resolves a tag to its current registry
# digest, so redeploying :latest picks up whatever CI last pushed — that is what makes the
# Portainer webhook work without the Business-Edition "Re-pull image" feature. Pinning a
# SHA makes every later redeploy faithfully reinstall that same image, with a green
# pipeline and restarted containers hiding it. Each build is also tagged :<sha>, so a
# rollback is just setting VERSION to that SHA deliberately.
VERSION=latest

# ---- Routing ----
# Plain hostname, NO backticks. The compose file already wraps it as Host(`...`).
# (The BACKEND stack's SITES variable is the opposite — backticks are part of that value,
# because its compose interpolates it straight into the rule. Do not copy one to the other.)
FRONTEND_DOMAIN=helpdesk.inventivebizsol.co.in

# Prefix for this stack's Traefik router/middleware/service names. Must be unique per
# stack on the shared Traefik, or two stacks silently fight over one router.
STACK_NAME=inventive-helpdesk-frontend

# ---- Backend ----
# Used at RUNTIME only by /api/health. The URLs the app actually proxies to are baked into
# the image at build time from the CI variables FRAPPE_URL and SOCKETIO_URL — changing this
# value alone does not repoint the app. It must match what the image was built with;
# /api/health reports `status: degraded` and an explicit `checks.config` error if it drifts.
FRAPPE_URL=https://helpdeskfrappe.inventivebizsol.co.in
